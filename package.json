{
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@huggingface/transformers": "4.3.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "dompurify": "3.4.17",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "intelephense": "1.18.5",
    "marked": "18.1.2",
    "pyright": "1.1.414",
    "typebox": "1.3.27",
    "typescript-language-server": "6.0.2",
    "typescript-lsp": "npm:typescript@6.0.3",
    "undici": "8.10.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "name": "audit-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local code auditing harness built on the Pi SDK",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "setup:java": "node scripts/setup-java.mjs",
    "smoke:graph": "node scripts/graph-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:inspection": "node scripts/inspection-smoke.mjs",
    "smoke:advanced": "node scripts/advanced-smoke.mjs",
    "smoke:context": "node scripts/context-smoke.mjs",
    "smoke:vectors": "tsx scripts/vector-smoke.mjs",
    "smoke:research": "node scripts/research-smoke.mjs"
  }
}
