# Web 工作台只监听本机。
PORT=4317
# 路径可包含中文；可在工作台里选择其他本地仓库。
# DEFAULT_REPO=/absolute/path/to/repository

MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_ID=deepseek-flash
MODEL_API=openai-completions
# 推荐在这里配置，或在工作台「模型配置」中填写。
DEEPSEEK_API_KEY=
# 非 DeepSeek 的兼容服务可使用 MODEL_API_KEY。
# MODEL_API_KEY=

# GitHub 访问代理，按本机端口修改；留空仍会使用默认 127.0.0.1:7890。
# 模型请求默认直接访问供应商。
GITHUB_PROXY=http://127.0.0.1:7890
# 可选：不想复用本机 DSH 的 DeepSeek key 时设为 false。
USE_DSH_CREDENTIALS=true
# 可选：数据目录，默认项目下 .audit-harness。
# AUDIT_DATA_DIR=/absolute/path/to/data

# 可选：GitHub API token（公开资料通常不需要），只用于服务端来源请求。
# GITHUB_TOKEN=
# 可选：Go 语义引用使用的 gopls 路径。
# GOPLS_PATH=/absolute/path/to/gopls
# 可选：覆盖语言服务器启动命令，JSON 中的值为 argv 数组。
# AUDIT_LSP_SERVERS={"go":["/absolute/path/to/gopls"]}

# OSV 默认共用 GitHub 代理；单独指定或设为空值可直连。
# OSV_PROXY=http://127.0.0.1:7890

# 本地真实 embedding 模型，首次使用会下载权重。
# 默认模型在源码中固定 revision；自定义模型可另行指定。
# AUDIT_EMBED_MODEL=Xenova/multilingual-e5-small
# AUDIT_EMBED_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
# 默认共用 GitHub 代理；显式设为空值可直接下载模型。
# AUDIT_EMBED_PROXY=
